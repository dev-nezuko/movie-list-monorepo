{
	"info": {
		"_postman_id": "00000000-0000-4000-8000-000000000000",
		"name": "Movie-List",
		"description": "Requests for the movie list API. Sign in with `Login API` first: its test script stores the token in `authToken`. `baseURL` defaults to the docker compose stack (nginx at http://localhost:8080/api); use http://127.0.0.1:3001 when running the API with `npm run dev`. Set `movieID` to an `_id` from `Retrieve Movies`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Login API",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 200) pm.collectionVariables.set('authToken', pm.response.json().token);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"demo@example.invalid\",\n    \"password\": \"<your local seed password>\"\n}"
				},
				"url": {
					"raw": "{{baseURL}}/login",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"login"
					]
				},
				"description": "- This endpoint is used for user authentication by providing a valid email and password.\n- The email and password must be sent in the request body as JSON.\n- Upon successful authentication, a JSON Web Token (JWT) is generated and returned in the response, along with user information.\n- In case of authentication failure, appropriate error messages are returned.\n- The generated JWT token should be included in the headers of subsequent requests to access protected routes.\n- The email is matched case-insensitively.\n- After 10 failed attempts from one address in 15 minutes the API answers 429.\n- The test script stores the token in the `authToken` collection variable."
			},
			"response": [
				{
					"name": "Login API - Response",
					"originalRequest": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"demo@example.invalid\",\n    \"password\": \"<your local seed password>\"\n}"
						},
						"url": {
							"raw": "{{baseURL}}/login",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"login"
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json; charset=utf-8"
						}
					],
					"cookie": [],
					"body": "{\n    \"token\": \"<JWT, valid for one hour>\",\n    \"user\": {\n        \"id\": \"6af1c9fb369fda0c102f2b58\",\n        \"email\": \"demo@example.invalid\"\n    }\n}"
				},
				{
					"name": "Login API - Too many failures",
					"originalRequest": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"demo@example.invalid\",\n    \"password\": \"<your local seed password>\"\n}"
						},
						"url": {
							"raw": "{{baseURL}}/login",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"login"
							]
						}
					},
					"status": "Too Many Requests",
					"code": 429,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json; charset=utf-8"
						}
					],
					"cookie": [],
					"body": "{\n    \"message\": \"Too many failed sign-in attempts; try again in 15 minutes\"\n}"
				}
			]
		},
		{
			"name": "Create a Movie",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "title",
							"value": "The Lantern Keeper",
							"type": "text"
						},
						{
							"key": "publicationYear",
							"value": "2002",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": [],
							"description": "PNG or JPEG, up to 5 MiB"
						}
					]
				},
				"url": {
					"raw": "{{baseURL}}/movies",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"movies"
					]
				},
				"description": "- This endpoint is used for creating a new movie entry.\n- The request must include a valid JWT token in the Authorization header for authentication.\n- The movie details such as title and publication year should be sent as form data.\n- In case of authentication failure or server error, appropriate error messages are returned.\n- Titles are trimmed (1-200 characters); the year must be four digits from 1888 to five years ahead.\n- The poster must really be a PNG or JPEG (checked by its bytes); otherwise the API answers 415."
			},
			"response": [
				{
					"name": "Create a Movie - Response",
					"originalRequest": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "title",
									"value": "The Lantern Keeper",
									"type": "text"
								},
								{
									"key": "publicationYear",
									"value": "2002",
									"type": "text"
								},
								{
									"key": "image",
									"type": "file",
									"src": [],
									"description": "PNG or JPEG, up to 5 MiB"
								}
							]
						},
						"url": {
							"raw": "{{baseURL}}/movies",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"movies"
							]
						}
					},
					"status": "Created",
					"code": 201,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json; charset=utf-8"
						}
					],
					"cookie": [],
					"body": "{\n    \"message\": \"Movie created successfully\",\n    \"movie\": {\n        \"_id\": \"6af1ca14b86a423b782d59a2\",\n        \"title\": \"The Lantern Keeper\",\n        \"publishYear\": 2002\n    }\n}"
				},
				{
					"name": "Create a Movie - Not an image",
					"originalRequest": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "title",
									"value": "The Lantern Keeper",
									"type": "text"
								},
								{
									"key": "publicationYear",
									"value": "2002",
									"type": "text"
								},
								{
									"key": "image",
									"type": "file",
									"src": [],
									"description": "PNG or JPEG, up to 5 MiB"
								}
							]
						},
						"url": {
							"raw": "{{baseURL}}/movies",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"movies"
							]
						}
					},
					"status": "Unsupported Media Type",
					"code": 415,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json; charset=utf-8"
						}
					],
					"cookie": [],
					"body": "{\n    \"message\": \"Posters must be PNG or JPEG images\"\n}"
				}
			]
		},
		{
			"name": "Retrieve Movies",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseURL}}/movies?page=1&pageSize=2",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"movies"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "pageSize",
							"value": "2"
						}
					]
				},
				"description": "- Lists the signed-in user's movies, newest first.\n- `page` (from 1) and `pageSize` (1-100, default 10) are optional query parameters.\n- Poster bytes are not included; fetch them from `/movies/:id/poster`.\n- `total` is the number of movies the user owns.\n- The test script copies the first `_id` into `movieID` when it is empty."
			},
			"response": [
				{
					"name": "Retrieve Movies - Response",
					"originalRequest": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseURL}}/movies?page=1&pageSize=2",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"movies"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "2"
								}
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json; charset=utf-8"
						}
					],
					"cookie": [],
					"body": "{\n    \"movies\": [\n        {\n            \"_id\": \"6af1ca14b86a423b782d59c0\",\n            \"title\": \"Weathervane\",\n            \"imageType\": \"image/png\",\n            \"publishYear\": 2008,\n            \"userId\": \"6af1c9fb369fda0c102f2b58\",\n            \"__v\": 0\n        },\n        {\n            \"_id\": \"6af1ca14b86a423b782d59bd\",\n            \"title\": \"The Last Ferry to Ardmore\",\n            \"imageType\": \"image/png\",\n            \"publishYear\": 1962,\n            \"userId\": \"6af1c9fb369fda0c102f2b58\",\n            \"__v\": 0\n        }\n    ],\n    \"page\": 1,\n    \"pageSize\": 2,\n    \"total\": 11\n}"
				}
			],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const first = pm.response.json().movies?.[0];",
							"if (first && !pm.collectionVariables.get('movieID')) pm.collectionVariables.set('movieID', first._id);"
						]
					}
				}
			]
		},
		{
			"name": "Retrieve a particular Movie item",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
