					"host": [
						"{{baseURL}}"
					],
					"path": [
						"movies",
						"{{movieID}}"
					]
				},
				"description": "- This endpoint is used for retrieving details of a specific movie by its unique identifier.\n    \n- The request must include a valid JWT token in the Authorization header for authentication.\n    \n- Upon successful retrieval, a JSON object with movie details is returned.\n    \n- In case of authentication failure, movie not found, or server error, appropriate error messages are returned.\n- Another user's movie answers 404, the same as a missing one."
			},
			"response": [
				{
					"name": "Retrieve a particular Movie item - Response",
					"originalRequest": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseURL}}/movies/{{movieID}}",
							"host": [
								"{{baseURL}}"
							],
							"path": [
								"movies",
								"{{movieID}}"
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json; charset=utf-8"
						}
					],
					"cookie": [],
					"body": "{\n    \"movie\": {\n        \"_id\": \"6af1ca14b86a423b782d59c0\",\n        \"title\": \"Weathervane\",\n        \"imageType\": \"image/png\",\n        \"publishYear\": 2008,\n        \"userId\": \"6af1c9fb369fda0c102f2b58\",\n        \"__v\": 0\n    }\n}"
				}
			]
		},
