PORT=3001
# 0.0.0.0 is needed inside a container; keep 127.0.0.1 on a workstation.
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/movie_list_demo
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops in front of the API (0 = none). Used for login rate limiting.
TRUST_PROXY=0
# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
SEED_USER_EMAIL=demo@example.invalid
SEED_USER_PASSWORD=
